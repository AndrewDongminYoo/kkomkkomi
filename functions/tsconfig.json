{
  "compilerOptions": {
    "module": "node20",
    "moduleResolution": "node16",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node", "jest"],
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "lib",
    "rootDir": "."
  },
  "include": ["src", "test"]
}
