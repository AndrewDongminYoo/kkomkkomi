{
  "version": "0.2",
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "dictionaries": [
    "vgv_allowed",
    "vgv_forbidden",
    "dart",
    "flutter",
    "swift",
    "cpp",
    "java",
    "kotlin",
    "softwareTerms",
    "filetypes",
    "fonts",
    "custom-dictionary"
  ],
  "dictionaryDefinitions": [
    {
      "name": "vgv_allowed",
      "path": "https://raw.githubusercontent.com/verygoodopensource/very_good_dictionaries/main/allowed.txt",
      "description": "Allowed VGV Spellings"
    },
    {
      "name": "vgv_forbidden",
      "path": "https://raw.githubusercontent.com/verygoodopensource/very_good_dictionaries/main/forbidden.txt",
      "description": "Forbidden VGV Spellings"
    },
    {
      "name": "custom-dictionary",
      "path": "./.cspell/custom-dictionary.txt",
      "addWords": true
    }
  ],
  "allowCompoundWords": false,
  "enableGlobDot": true,
  "useGitignore": true,
  "ignoreWords": ["meta-data", "plaintext", "white-space"],
  "ignorePaths": [".git", ".gitignore", ".metadata", "web/google*.html"],
  "overrides": [
    {
      "filename": ["**/*.html", "cspell.json"],
      "ignoreWords": ["white-space"]
    },
    {
      "filename": ["**/*.xib", "cspell.json"],
      "ignoreWords": ["Instantitation"]
    }
  ],
  "words": [
    "393JTTV68D",
    "dongminyu",
    "donminzzi",
    "felixangelov",
    "firerules",
    "KakaoTalk",
    "Kkomkkomi",
    "playstore",
    "postcoverage",
    "precheck",
    "probs",
    "revenuecat",
    "subosito",
    "toba",
    "vsfire"
  ]
}
